        "pattern": "^(?P<period>本期|上期|往期)?(?:拟境湮灭战|拟境|湮灭战|湮灭)$"
      }
    },
    {
      "id": "void_front",
      "name": "临界推演",
      "description": "临界推演战绩",
      "usage": "#[上期]临界推演 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<period>本期|上期|往期)?(?:临界推演|临界|推演)$"
      }
    },
    {
      "id": "zenkov_detail",
      "name": "迷宫记录",
      "description": "迷宫诡域的高危模式地图与探索记录",
      "usage": "#迷宫记录 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:迷宫诡域|迷宫|诡域|搜打撤|塔科夫|塔可夫|塔克夫|鸭科夫|绝科夫)(?:战绩|记录|详情|回顾)$"
      }
    },
    {
      "id": "build",
      "name": "伤害",
      "description": "按固定参考情境自动计算代理人技能伤害",
      "usage": "#<角色>伤害 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.*?)伤害(?:[0-9]*)$"
      }
    },
    {
      "id": "guide-help",
      "name": "攻略帮助",
      "description": "攻略的用法与各来源序号",
      "usage": "#攻略帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "攻略帮助",
          "攻略说明"
        ]
      }
    },
    {
      "id": "guide-default",
      "name": "设置默认攻略",
      "description": "设置默认使用的攻略来源序号，0 或 all 为前几个来源的合集",
      "usage": "#设置默认攻略<来源序号|all>",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^设置默认攻略(?P<source>[0-9]+|all)?$"
      }
    },
    {
      "id": "guide-forward-count",
      "name": "设置所有攻略显示个数",
      "description": "设置 all 或 0 时显示前几个攻略来源（1–7，默认 4）",
      "usage": "#设置所有攻略显示个数4",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^设置所有攻略显示个数(?P<count>[0-9]*)$"
      }
    },
    {
      "id": "guides",
      "name": "攻略",
      "description": "发送米游社攻略合集中该角色的攻略图，可接来源序号，all 为前几个来源",
      "usage": "#[更新]<角色>攻略[来源序号]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:更新|刷新)?(?P<character>.*?)攻略(?:[0-9]+|all)?$"
      }
    },
    {
      "id": "talent-wiki",
      "name": "角色技能",
      "description": "角色的技能与意象影画资料（来自 Nanoka），技能可接等级",
      "usage": "%艾莲技能 [普攻.闪避.支援.特殊.连携.核心] / %艾莲影画",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)(?:(?:天赋|技能)[0-9A-Za-z.\\s]*|意象影画|意象|影画|命座)$"
      }
    },
    {
      "id": "catalog",
      "name": "图鉴",
      "description": "查看资料；已下载 Atlas 绝区零图鉴时发送对应图鉴图",
      "usage": "#<名称>图鉴",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<name>.*?)图鉴$"
      }
    },
    {
      "id": "materials",
      "name": "培养材料",
      "description": "发送已下载 Atlas 绝区零图鉴中该角色的突破与培养材料图",
      "usage": "#<角色>材料",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<name>.+?)(?:突破|材料|素材|培养)$"
      }
    },
    {
      "id": "character",
      "name": "面板",
      "description": "查看代理人面板",
      "usage": "#<角色>面板 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>.+?)面板$"
      }
    },
    {
      "id": "atlas",
      "name": "Atlas 图鉴",
      "description": "其他命令都不匹配时，按 Atlas 的规则在已下载的图鉴库中查找并发送图片",
      "usage": "%艾莲 / %深海访客",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^.+$",
        "fallback": true
      }
    }
  ],

          "苗圃"
        ]
      }
    },
    {
      "id": "lost_void",
      "name": "迷失之地",
      "description": "迷失之地的执照等级与任务进度",
      "usage": "#迷失之地 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "迷失之地",
          "迷失"
        ]
      }
    },
    {
      "id": "zenkov",
      "name": "迷宫诡域",
      "description": "迷宫诡域的赛季等级、周常委托与珍品图鉴",
      "usage": "#迷宫诡域 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "迷宫诡域",
          "迷宫",
          "诡域",
          "搜打撤",
          "塔科夫",
          "塔可夫",
          "塔克夫",
          "鸭科夫",
          "绝科夫"
        ]
      }
    },
    {
      "id": "exploration",
      "name": "探索",
      "description": "各区域的收集进度",
      "usage": "#探索 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "探索",
          "区域收集",
          "收集",
          "探索度"
        ]
      }
    },
    {
      "id": "score",
      "name": "评分",
      "description": "按角色专属权重计算装备评分",
      "usage": "#评分 <角色> [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "评分"
        ]
      }
    },
    {
      "id": "reminder",
      "name": "开启体力推送",
      "description": "电量达到设定比例时提醒",
      "usage": "#开启体力推送 [百分比] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "开启体力推送",
          "体力提醒"
        ]
      }
    },
    {
      "id": "reminder-stop",
      "name": "关闭体力推送",
      "description": "关闭体力提醒",
      "usage": "#关闭体力推送 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "关闭体力推送",
          "关闭提醒"
        ]
      }
    },
    {
      "id": "group-settings",
      "name": "群设置",
      "description": "调整当前群的游戏设置",
      "usage": "#群设置 [开启|关闭|图片|文本|默认|别名|删除别名]",
      "permission": "group_admin",
      "trigger": {
        "type": "exact",
        "names": [
          "群设置"
        ]
      }
    },
    {
      "id": "alias-set",
      "name": "添加别名",
      "description": "给角色添加对所有群生效的别名",
      "usage": "#添加艾莲别名鲨鲨",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^添加(?P<character>\\S+)别名(?P<alias>\\S+)$"
      }
    },
    {
      "id": "alias-remove",
      "name": "删除别名",
      "description": "删除自定义别名，角色本名与内置别名不能删除",
      "usage": "#删除别名鲨鲨",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^删除别名(?P<alias>\\S+)$"
      }
    },
    {
      "id": "aliases",
      "name": "角色别名",
      "description": "查看角色的全部别名",
      "usage": "#艾莲别名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?P<character>\\S+)别名$"
      }
    },
    {
      "id": "query-rank",
      "name": "深渊排名",
      "description": "本群成员在群内查询过的式舆防卫战、危局强袭战（含绝境）、拟境湮灭战、临界推演与拟真鏖战试炼排名",
      "usage": "%深渊排名 / %危局排名 / %绝境排名 / %拟境排名 / %推演排名 / %爬塔S1排名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:式舆防卫战|式舆|深渊|防卫战|防卫|危局强袭战|危局|强袭|强袭战|拟境湮灭战|拟境|湮灭|湮灭战|临界推演|临界|推演|绝境|(?:危局|强袭|强袭战|危局强袭战)绝境|绝境(?:危局|强袭|强袭战|危局强袭战)|爬塔 ?[Ss][1-4]|拟真鏖战试炼|鏖战试炼[：:]?(?:末路|荣耀|狂澜))排名$"
      }
    },
    {
      "id": "query-rank-help",
      "name": "爬塔排名",
      "description": "列出可查询的拟真鏖战试炼排名",
      "usage": "%爬塔排名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:爬塔|鏖战)排名$"
      }
    },
    {
      "id": "query-rank-switch",
      "name": "显示深渊排名",
      "description": "在本群排名中显示或隐藏自己的 UID，不写玩法时设置全部排名",
      "usage": "%显示深渊排名 / %隐藏危局排名 / %隐藏排名",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:显示|展示|开启|打开|on|启用|启动|隐藏|取消显示|关闭|关掉|off|禁用|停止)(?:式舆防卫战|式舆|深渊|防卫战|防卫|危局强袭战|危局|强袭|强袭战|拟境湮灭战|拟境|湮灭|湮灭战|临界推演|临界|推演|爬塔S1|爬塔S2|爬塔S3|爬塔 s1|爬塔 s2|爬塔 s3|爬塔s1|爬塔s2|爬塔s3)?(?:群内?)?排名$"
      }
    },
    {
      "id": "group-rank-switch",
      "name": "开关群内排名",
      "description": "开启或关闭所有群的挑战排名，关闭时不再保存查询的战绩",
      "usage": "#开启群内深渊排名 / #关闭群内深渊排名",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:开启|打开|on|启用|启动|关闭|关掉|off|禁用|停止)群内?(?:式舆防卫战|式舆|深渊|防卫战|防卫|危局强袭战|危局|强袭|强袭战|临界推演|临界|推演)排名$"
      }
    },
    {
      "id": "query-rank-reset",
      "name": "清空排名",
      "description": "清空本群式舆防卫战、危局强袭战（含绝境）或临界推演的排名",
      "usage": "#重置深渊排名 / #清空危局排名 / #清空临界排名",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:重置|清空)(?:式舆防卫战|式舆|深渊|防卫战|防卫|危局强袭战|危局|强袭战|强袭|临界推演|临界|推演)排名$"
      }
    },

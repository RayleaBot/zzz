{
  "id": "raylea.zzz",
  "name": "绝区零",
  "version": "0.1.0",
  "manifest_version": "4",
  "min_core_version": "0.7.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "description": "绝区零独立查询、离线图鉴、公开展柜与抽卡档案",
    "author": "raylea"
  },
  "concurrency": 4,
  "command_prefixes": {
    "dedicated": [
      "%",
      "％",
      "绝区零",
      "绝区",
      "zzz",
      "ZZZ"
    ],
    "settings_key": "command_prefixes",
    "accept_global": false
  },
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger"
  ],
  "default_config": {
    "account_provider": "raylea.mihoyo-accounts",
    "image_replies": true,
    "custom_aliases": {},
    "command_prefixes": [
      "%",
      "％",
      "绝区零",
      "绝区",
      "zzz",
      "ZZZ"
    ],
    "challenge_remind_enabled": true,
    "challenge_remind_time": "每日20时",
    "challenge_abyss_level": 5,
    "challenge_deadly_stars": 6,
    "group_rank_enabled": true,
    "panel_refresh_interval": 60
  },
  "commands": [
    {
      "id": "profile",
      "name": "卡片",
      "description": "玩家信息与代理人卡片",
      "usage": "#卡片 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "卡片",
          "card",
          "个人信息",
          "信息"
        ]
      }
    },
    {
      "id": "note",
      "name": "体力",
      "description": "电量、每日活跃与录像店经营等实时便笺",
      "usage": "#体力 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "体力",
          "便笺",
          "便签",
          "每日",
          "note",
          "树脂",
          "查询体力"
        ]
      }
    },
    {
      "id": "characters",
      "name": "角色",
      "description": "已拥有的代理人列表",
      "usage": "#角色 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "角色"
        ]
      }
    },
    {
      "id": "training",
      "name": "练度统计",
      "description": "全部代理人的影画、等级、技能、音擎与驱动盘评级",
      "usage": "#练度统计 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^练度(?:统计)?$"
      }
    },
    {
      "id": "buddies",
      "name": "邦布",
      "description": "已拥有的邦布列表",
      "usage": "#邦布 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "邦布",
          "人偶"
        ]
      }
    },
    {
      "id": "accounts",
      "name": "账号",
      "description": "查看已绑定的 UID（账号与无 CK 绑定），uid加序号切换",
      "usage": "#uid / #uid2",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:账号|(?i:(?:我的)?uid)[0-9]{0,2})$"
      }
    },
    {
      "id": "device-bind",
      "name": "绑定设备",
      "description": "出现 10041 时绑定设备（之后私聊发送设备信息）",
      "usage": "#绑定设备",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "绑定设备"
        ]
      }
    },
    {
      "id": "device-help",
      "name": "绑定设备帮助",
      "description": "如何获取与导入设备信息",
      "usage": "#绑定设备帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "绑定设备帮助"
        ]
      }
    },
    {
      "id": "device-unbind",
      "name": "解绑设备",
      "description": "恢复所绑定账号的默认设备",
      "usage": "#解绑设备",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "解绑设备"
        ]
      }
    },
    {
      "id": "device-default",
      "name": "设置默认设备",
      "description": "设置没有绑定设备的账号使用的默认设备（之后私聊发送设备信息）",
      "usage": "#设置默认设备",
      "permission": "super_admin",
      "trigger": {
        "type": "exact",
        "names": [
          "设置默认设备"
        ]
      }
    },
    {
      "id": "panel-refresh",
      "name": "更新面板",
      "description": "更新面板：已绑定账号读取米游社数据，否则或写“展柜”时读取 Enka 展柜",
      "usage": "#更新面板 / #更新展柜面板",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:(?:刷新|更新)(?:展柜)?面板(?:展柜)?(?:刷新|更新|列表)?|(?:展柜)?面板(?:展柜)?(?:刷新|更新))$"
      }
    },
    {
      "id": "panel-list",
      "name": "面板列表",
      "description": "已保存面板的代理人列表",
      "usage": "#面板列表",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:.*?(?:展柜)?面板(?:展柜)?列表|(?:展柜)?面板(?:展柜)?)$"
      }
    },
    {
      "id": "panel-image-upload",
      "name": "上传面板图",
      "description": "为角色添加自定义面板图：随消息附带图片，或引用含图片（含合并转发）的消息",
      "usage": "#上传艾莲面板图",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:上传|添加)(?P<character>\\S+?)(?:角色|面板)图$"
      }
    },
    {
      "id": "panel-image-list",
      "name": "查看面板图",
      "description": "查看角色的自定义面板图及其 ID，每页五张",
      "usage": "#查看艾莲面板图[页码]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:获取|查看)(?P<character>\\S+?)(?:角色|面板)图(?P<page>[0-9]*)$"
      }
    },
    {
      "id": "panel-image-remove",
      "name": "删除面板图",
      "description": "按 ID 删除角色的自定义面板图，ID 用逗号、顿号或空格分隔",
      "usage": "#删除艾莲面板图1,2",
      "permission": "super_admin",
      "trigger": {
        "type": "pattern",
        "pattern": "^删除(?P<character>\\S+?)(?:角色|面板)图(?P<ids>\\S*)$"
      }
    },
    {
      "id": "gacha-help",
      "name": "抽卡帮助",
      "description": "抽卡记录的获取与查看方法",
      "usage": "#抽卡帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡帮助"
        ]
      }
    },
    {
      "id": "gacha-link",
      "name": "抽卡链接",
      "description": "私聊发送抽卡链接以更新抽卡记录",
      "usage": "#抽卡链接",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡链接"
        ]
      }
    },
    {
      "id": "gacha-link-get",
      "name": "获取抽卡链接",
      "description": "私聊获取本人国服角色的抽卡链接",
      "usage": "#获取抽卡链接",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "获取抽卡链接"
        ]
      }
    },
    {
      "id": "gacha",
      "name": "抽卡分析",
      "description": "分析已导入的抽卡记录",
      "usage": "#抽卡分析 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "抽卡分析",
          "抽卡记录",
          "抽卡统计",
          "抽卡"
        ]
      }
    },
    {
      "id": "monthly",
      "name": "月报",
      "description": "本月或指定月份的菲林、母带与邦布券收入",
      "usage": "#月报[2025年3月|上月] [UID] / #月报 [YYYYMM] [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?:月报|monthly|菲林|邦布券|收入)(?P<month>(?:[0-9]{4}年)?(?:(?:[0-9]{1,2}|上)月)?)$"
      }
    },
    {
      "id": "tower",
      "name": "拟真鏖战试炼",
      "description": "拟真鏖战试炼战绩",
      "usage": "#拟真鏖战试炼 [UID]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "拟真鏖战试炼",
          "鏖战",
          "爬塔"
        ]
      }
